# HADIR API — local development
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-change-me-0000000000000000

# Optional. When absent, QR signature verification reports "not configured".
# Format: {"202610":{"id":"k1","secret":"<base64 secret>"}}
QR_KEYRING_JSON=

# Enables /v1/dev/* routes (simulation). Keep false in production.
DEV_TOOLS=true
