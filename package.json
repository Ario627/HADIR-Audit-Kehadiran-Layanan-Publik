{
  "name": "hadir",
  "version": "0.1.0",
  "private": true,
  "description": "HADIR — instrumen audit warga untuk layanan bus bersubsidi",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @hadir/web dev",
    "dev:api": "pnpm --filter @hadir/api start:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hadir/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "db:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
